# Google Maps (optional). When set, a static map tile is shown for your parked location.
# Get a key at https://console.cloud.google.com/apis/credentials (enable "Maps Static API").
# IMPORTANT: Lock the key down in Google Cloud Console:
#   - Application restrictions → HTTP referrers → add your production domain(s)
#     and http://localhost:5173/* for dev.
#   - API restrictions → Restrict key → check only "Maps Static API".
# The key appears in image URLs in the browser; referrer restrictions are what make that safe.
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (required for sign analysis and cross-device sync).
# Create a project at https://supabase.com, then run supabase/schema.sql in the SQL Editor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sign analysis runs through the `analyze-sign` Supabase Edge Function. The
# Gemini API key is held server-side as a Supabase secret, not shipped to the client:
#   supabase functions deploy analyze-sign
#   supabase secrets set GEMINI_API_KEY=<your-key>
# Get a Gemini key at https://aistudio.google.com/apikey
